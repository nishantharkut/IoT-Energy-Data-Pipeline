{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coursework.local/schemas/replay-receipt-v2.schema.json",
  "title": "Streaming replay acknowledgement receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "replay_run_id", "replay_manifest_hash",
    "schedule_hash", "expected_delivery_count", "acknowledged_delivery_count",
    "acknowledgement_ledger", "terminal_offsets"
  ],
  "properties": {
    "schema_version": {"const": "replay-receipt-v2"},
    "status": {"const": "complete"},
    "replay_run_id": {"type": "string", "minLength": 1},
    "replay_manifest_hash": {"$ref": "#/$defs/sha256"},
    "schedule_hash": {"$ref": "#/$defs/sha256"},
    "expected_delivery_count": {"$ref": "#/$defs/count"},
    "acknowledged_delivery_count": {"$ref": "#/$defs/count"},
    "acknowledgement_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "record_count", "byte_size", "sha256"],
      "properties": {
        "file": {"const": "replay-acknowledgements.ndjson"},
        "record_count": {"$ref": "#/$defs/count"},
        "byte_size": {"$ref": "#/$defs/count"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "terminal_offsets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^(0|[1-9][0-9]*)$"},
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "count": {"type": "integer", "minimum": 0}
  }
}
